POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rags
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=vacancies

# Groq cloud inference (LPU-accelerated — set this to use Groq instead of Ollama)
# Get your key at: https://console.groq.com
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_LIGHT_LLM_MODEL=llama-3.1-8b-instant

# Ollama (local fallback — used only when GROQ_API_KEY is not set)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_LIGHT_MODEL=llama3.2:1b

BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
